{
  "name": "openbooks",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "packages/countries/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun --bun vp test",
    "check": "vp check && bun run --cwd apps/web check:svelte",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "5.0.1"
  }
}
